# 실제 값은 .env 파일에만 채우고, .env는 절대 커밋하지 않는다.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 배포 후 API를 두드릴 수 있는 공유 비밀 헤더 값. 아무 무작위 문자열이나 생성해서 채운다.
APP_SHARED_SECRET=
# 배포 환경에서는 "production"으로 설정 (FastAPI 문서 화면 /docs, /redoc을 끄기 위함)
ENVIRONMENT=
# 프론트엔드 배포 주소 (쉼표로 여러 개 가능). 로컬 개발 기본값은 http://localhost:3000
ALLOWED_ORIGINS=
